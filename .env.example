# Local: npm run db:local starts PGlite on :5433 → run scripts with LOCAL_PGLITE=1
DATABASE_URL=postgres://postgres:postgres@localhost:5433/postgres
LOCAL_PGLITE=1
NEXT_PUBLIC_SERVER_URL=http://localhost:3030
# Optional: when empty, derived from DATABASE_URL (same as on Vercel)
PAYLOAD_SECRET=
# production only (Vercel Blob integration sets it):
BLOB_READ_WRITE_TOKEN=
