{
  "name": "mymuse-site",
  "version": "1.0.0",
  "description": "MyMuse website: Next.js + Payload CMS",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -p 3030",
    "db:local": "pglite-server --db=.pgdata --port=5433 --max-connections=16",
    "db:bridge": "node src/import/neon-ws-bridge.cjs",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "ci": "cross-env NODE_OPTIONS=--no-deprecation payload migrate && npm run build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed.ts",
    "import:wp": "cross-env NODE_OPTIONS=--no-deprecation payload run src/import/wordpress.ts",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint ."
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.92.0",
    "@payloadcms/live-preview-react": "^3.92.0",
    "@payloadcms/next": "3.92.0",
    "@payloadcms/richtext-lexical": "3.92.0",
    "@payloadcms/storage-vercel-blob": "^3.92.0",
    "@payloadcms/translations": "^3.92.0",
    "@payloadcms/ui": "3.92.0",
    "@vercel/blob": "^2.3.1",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "next": "^16.4.3",
    "payload": "3.92.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "^0.0.1",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.16.0",
    "eslint-config-next": "^16.4.3",
    "prettier": "^3.4.2",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=20.18.1"
  }
}
