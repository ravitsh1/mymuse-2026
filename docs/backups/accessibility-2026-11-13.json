m"},"format":"","indent":0,"version":3,"children":[{"mode":"normal","text":"בדפדפני","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":null},{"id":"6af41ee437864a8c7f3a4785","type":"link","fields":{"url":"https://www.isoc.org.il/files/w3c-wai/guidelines.html","newTab":false,"linkType":"custom"},"format":"","indent":0,"version":3,"children":[{"mode":"normal","text":" ","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":null},{"id":"6af41ee437864a8c7f3a4786","type":"link","fields":{"url":"https://www.isoc.org.il/files/w3c-wai/guidelines.html","newTab":false,"linkType":"custom"},"format":"","indent":0,"version":3,"children":[{"mode":"normal","text":"אינטרנט","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":null},{"id":"6af41ee437864a8c7f3a4787","type":"link","fields":{"url":"https://www.isoc.org.il/files/w3c-wai/guidelines.html","newTab":false,"linkType":"custom"},"format":"","indent":0,"version":3,"children":[{"mode":"normal","text":".","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":null}],"direction":null,"textStyle":"","textFormat":0},{"type":"paragraph","format":"right","indent":0,"version":1,"children":[{"mode":"normal","text":" ","type":"text","style":"","detail":0,"format":1,"version":1}],"direction":null,"textStyle":"","textFormat":1},{"tag":"h2","type":"heading","format":"right","indent":0,"version":1,"children":[{"mode":"normal","text":"כיצד עוברים למצב נגיש?","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":null},{"type":"paragraph","format":"right","indent":0,"version":1,"children":[{"mode":"normal","text":"באתר מוצב אייקון נגישות (בד\"כ בדפנות האתר). לחיצה על האייקון מאפשרת פתיחת של תפריט הנגישות. לאחר בחירת הפונקציה המתאימה בתפריט יש להמתין לטעינת הדף ולשינוי הרצוי בתצוגה (במידת הצורך).","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":null,"textStyle":"","textFormat":0},{"type":"paragraph","format":"right","indent":0,"version":1,"children":[{"mode":"normal","text":"במידה ומעוניינים לבטל את הפעולה, יש ללחוץ על הפונקציה בתפריט פעם שניה. בכל מצב, ניתן לאפס הגדרות נגישות.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":null,"textStyle":"","textFormat":0},{"type":"paragraph","format":"right","indent":0,"version":1,"children":[{"mode":"normal","text":"התוכנה פועלת בדפדפנים הפופולריים: Chrome, Firefox, Safari, Opera בכפוף (תנאי יצרן) הגלישה במצב נגישות מומלצת בדפדפן כרום.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":null,"textStyle":"","textFormat":0},{"type":"paragraph","format":"right","indent":0,"version":1,"children":[{"mode":"normal","text":"האתר מספק מבנה סמנטי עבור טכנולוגיות מסייעות ותמיכה בדפוס השימוש המקובל להפעלה עם מקלדת בעזרת מקשי החיצים, Enter ו- Esc ליציאה מתפריטים וחלונות.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":null,"textStyle":"","textFormat":0},{"type":"paragraph","format":"right","indent":0,"version":1,"children":[{"mode":"normal","text":"לצורך קבלת חווית גלישה מיטבית עם תוכנת הקראת מסך, אנו ממליצים לשימוש בתוכנת  NVDA העדכנית ביותר.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":null,"textStyle":"","textFormat":0},{"type":"paragraph","format":"right","indent":0,"version":1,"children":[{"mode":"normal","text":" ","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":null,"textStyle":"","textFormat":0},{"tag":"h2","type":"heading","format":"right","indent":0,"version":1,"children":[{"mode":"normal","text":"תיקונים והתאמות שבוצעו באתר:","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":null},{"type":"paragraph","format":"right","indent":0,"version":1,"children":[{"mode":"normal","text":"התאמה לקורא מסך - התאמת האתר עבור טכנולוגיות מסייעות כגון NVDA , JAWS","type":"text","style":"","detail":0,"format":0,"version":1},{"type":"linebreak","version":1},{"mode":"normal","text":"אמצעי הניווט באתר פשוטים וברורים.","type":"text","style":"","detail":0,"format":0,"version":1},{"type":"linebreak","version":1},{"mode":"normal","text":"תכני האתר כתובים באופן ברור, מסודר והיררכי.","type":"text","style":"","detail":0,"format":0,"version":1},{"type":"linebreak","version":1},{"mode":"normal","text":"האתר מותאם לצפייה בדפדפנים מודרניים.","type":"text","style":"","detail":0,"format":0,"version":1},{"type":"linebreak","version":1},{"mode":"normal","text":"התאמת האתר לתצוגה תואמת מגוון מסכים ורזולוציות.","type":"text","style":"","detail":0,"format":0,"version":1},{"type":"linebreak","version":1},{"mode":"normal","text":"כל הדפים באתר בעלי מבנה קבוע (1H/2H/3H וכו').","type":"text","style":"","detail":0,"format":0,"version":1},{"type":"linebreak","version":1},{"mode":"normal","text":"לכל התמונות באתר יש הסבר טקסטואלי חלופי (alt).","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":null,"textStyle":"","textFormat":0},{"tag":"h2","type":"heading","format":"right","indent":0,"version":1,"children":[{"mode":"normal","text":"פונקציונליות תוכנת נגישות:","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":null},{"type":"paragraph","format":"right","indent":0,"version":1,"children":[{"mode":"normal","text":"התאמה לקורא מסך - התאמת האתר עבור טכנולוגיות מסייעות כגון NVDA , JAWS","type":"text","style":"","detail":0,"format":0,"version":1},{"type":"linebreak","version":1},{"mode":"normal","text":"עצירת הבהובים - עצירת אלמנטים נעים וחסימת אנימציות","type":"text","style":"","detail":0,"format":0,"version":1},{"type":"linebreak","version":1},{"mode":"normal","text":"דילוג ישיר לתוכן - דילוג על התפריט הראשי ישירות אל התוכן.","type":"text","style":"","detail":0,"format":0,"version":1},{"type":"linebreak","version":1},{"mode":"normal","text":"התאמה לניווט מקלדת.","type":"text","style":"","detail":0,"format":0,"version":1},{"type":"linebreak","version":1},{"mode":"normal","text":"הגדלה / הקטנה של טקסט.","type":"text","style":"","detail":0,"format":0,"version":1},{"type"